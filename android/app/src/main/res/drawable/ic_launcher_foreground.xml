<?xml version="1.0" encoding="utf-8"?>
<!-- Open channel flow: no-slip wall (bottom), dashed free surface (top), a turbulent mean
     velocity profile (zero at the wall, maximum at the surface) and two vortex swirls. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- swirls -->
    <path
        android:strokeColor="#9EC5F4"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M46,58 a2,2 0 0,1 4,0 a4,4 0 0,1 -8,0 a6,6 0 0,1 12,0 a8,8 0 0,1 -16,0" />
    <path
        android:strokeColor="#9EC5F4"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M56,44 a1.5,1.5 0 0,0 -3,0 a3,3 0 0,0 6,0 a4.5,4.5 0 0,0 -9,0 a6,6 0 0,0 12,0" />
    <!-- velocity axis -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M34,74 L34,32" />
    <!-- mean velocity profile U(y): zero at the wall, maximum at the surface -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,74 L42.2,73.6 L48,72 L51.6,70 L58,64 L64.2,54 L68.5,44 L72,34" />
    <!-- wall -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,74 L78,74 L78,78 L30,78 Z" />
    <!-- free surface -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M30,32 L36,32 M40,32 L46,32 M50,32 L56,32 M60,32 L66,32 M70,32 L78,32" />
</vector>
